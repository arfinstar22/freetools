# ==========================================
# FreeTools Backend / Serverless Configuration
# ==========================================

# Secret API Key untuk OpenRouter (HANYA terbaca di serverless / backend gateway, TIDAK PERNAH masuk bundle client)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Opsional: Custom Proxy URL jika gateway di-deploy di host terpisah (Default: /api/ai-intent)
# VITE_AI_PROXY_URL=/api/ai-intent
